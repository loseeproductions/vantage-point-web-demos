nt-weight:600;font-size:16.5px\">{{ e.title }}<\u002Fdiv>\n              <div style=\"color:#6B5A48;font-size:15px;line-height:1.6\">{{ e.desc }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- Gallery -->\n<section id=\"gallery\" style=\"max-width:1280px;margin:0 auto;padding:90px 5vw\">\n  <div data-reveal=\"\" style=\"text-align:center;margin-bottom:48px\">\n    <div style=\"color:#9C6B4A;font-weight:600;font-size:13px;letter-spacing:3.5px;text-transform:uppercase\">Recent Work<\u002Fdiv>\n    <h2 style=\"font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(36px,4vw,54px);margin:12px 0 0\">From our chairs<\u002Fh2>\n  <\u002Fdiv>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px\">\n    <sc-for list=\"{{ gallery }}\" as=\"g\" hint-placeholder-count=\"4\">\n      <div data-reveal=\"\" style=\"overflow:hidden;border-radius:14px\">\n        <img src=\"{{ g }}\" alt=\"Salon work\" style=\"width:100%;display:block;aspect-ratio:3/4;object-fit:cover;transition:transform .6s ease\" style-hover=\"transform:scale(1.06)\">\n      <\u002Fdiv>\n    <\u002Fsc-for>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- Reviews -->\n<section style=\"background:#2B2118;color:#EFE5D8;padding:100px 5vw\">\n  <div style=\"max-width:900px;margin:0 auto;text-align:center\">\n    <div data-reveal=\"\" style=\"color:#C99A3F;letter-spacing:4px;font-size:20px;margin-bottom:26px\">★★★★★<\u002Fdiv>\n    <div data-reveal=\"\" style=\"font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(24px,3vw,34px);line-height:1.5\">“{{ activeReview.text }}”<\u002Fdiv>\n    <div data-reveal=\"\" style=\"margin-top:26px;font-size:14.5px;letter-spacing:2px;text-transform:uppercase;color:#B39B7E\">{{ activeReview.name }} · {{ activeReview.detail }}<\u002Fdiv>\n    <div data-reveal=\"\" style=\"display:flex;gap:10px;justify-content:center;margin-top:36px\">\n      <sc-for list=\"{{ reviewDots }}\" as=\"d\" hint-placeholder-count=\"3\">\n        <button onclick=\"{{ d.go }}\" style=\"width:10px;height:10px;border-radius:50%;border:none;cursor:pointer;background:{{ d.bg }};padding:0\" title=\"Show review\"><\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- Visit -->\n<section id=\"visit\" style=\"max-width:1100px;margin:0 auto;padding:90px 5vw;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:44px;align-items:center\">\n  <div data-reveal=\"\">\n    <div style=\"color:#9C6B4A;font-weight:600;font-size:13px;letter-spacing:3.5px;text-transform:uppercase\">Visit Us<\u002Fdiv>\n    <h2 style=\"font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,3.8vw,50px);margin:12px 0 20px\">On Bull Street, in the heart of Savannah<\u002Fh2>\n    <div style=\"display:flex;flex-direction:column;gap:14px;font-size:15.5px;color:#6B5A48;line-height:1.6\">\n      <div><strong style=\"color:#2B2118\">Address<\u002Fstrong><br>1206 Bull Street, Savannah, GA 31401<\u002Fdiv>\n      <div><strong style=\"color:#2B2118\">Hours<\u002Fstrong><br>Tue–Fri 9am–7pm · Sat 8am–5pm · Sun–Mon closed<\u002Fdiv>\n      <div><strong style=\"color:#2B2118\">Contact<\u002Fstrong><br>(912) 555-0163 · hello@gildedrootsalon.com<\u002Fdiv>\n    <\u002Fdiv>\n    <button onclick=\"{{ openChat }}\" style=\"margin-top:26px;background:#2B2118;color:#FAF6F1;border:none;cursor:pointer;font:inherit;font-weight:500;font-size:15px;letter-spacing:1px;padding:15px 30px;border-radius:999px\" style-hover=\"background:#9C6B4A\">Book an Appointment<\u002Fbutton>\n  <\u002Fdiv>\n  <div data-reveal=\"\">\n    <img src=\"1fe70eac-1345-4f7e-914b-fb912ae5f2f1\" alt=\"Salon chairs\" style=\"width:100%;border-radius:18px;display:block;aspect-ratio:4/4.4;object-fit:cover\">\n  <\u002Fdiv>\n<\u002Fsection>\n\n<!-- Footer -->\n<footer style=\"border-top:1px solid #E8DED2;padding:40px 5vw;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center;color:#8A755E;font-size:14px\">\n  <div style=\"font-family:'Cormorant Garamond',serif;font-weight:700;font-size:20px;color:#2B2118\">Gilded Root <span style=\"font-style:italic;font-weight:500;color:#9C6B4A\">salon<\u002Fspan><\u002Fdiv>\n  <div>1206 Bull Street, Savannah, GA · (912) 555-0163<\u002Fdiv>\n  <div>Tue–Sat · Walk-ins welcome when the chair is free<\u002Fdiv>\n<\u002Ffooter>\n\n<!-- Chat launcher -->\n<sc-if value=\"{{ chatClosed }}\" hint-placeholder-val=\"{{ true }}\">\n  <button onclick=\"{{ openChat }}\" style=\"position:fixed;right:22px;bottom:22px;z-index:90;width:62px;height:62px;border-radius:50%;background:#2B2118;border:none;cursor:pointer;display:grid;place-items:center;box-shadow:0 12px 32px rgba(43,33,24,.35)\" style-hover=\"background:#9C6B4A;transform:scale(1.06)\" title=\"Chat with us\">\n    <span style=\"width:28px;height:28px;background:#FAF6F1;-webkit-mask:url(&quot;536e59c8-df44-4274-9ce7-161a89291924&quot;) center/contain no-repeat;mask:url(&quot;536e59c8-df44-4274-9ce7-161a89291924&quot;) center/contain no-repeat\"><\u002Fspan>\n  <\u002Fbutton>\n<\u002Fsc-if>\n\n<!-- Chat panel -->\n<sc-if value=\"{{ chatOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:22px;bottom:22px;z-index:95;width:min(380px,calc(100vw - 44px));height:min(560px,calc(100vh - 60px));background:#fff;border-radius:20px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 30px 70px rgba(43,33,24,.35);animation:chatPop .35s ease\">\n    <div style=\"background:#2B2118;color:#FAF6F1;padding:16px 20px;display:flex;align-items:center;gap:12px\">\n      <div style=\"width:38px;height:38px;border-radius:50%;background:#9C6B4A;display:grid;place-items:center;font-family:'Cormorant Garamond',serif;font-weight:700;font-size:19px\">G<\u002Fdiv>\n      <div style=\"flex:1\">\n        <div style=\"font-weight:600;font-size:15.5px\">Goldie — Salon Assistant<\u002Fdiv>\n        <div style=\"font-size:12.5px;opacity:.75;display:flex;align-items:center;gap:6px\"><span style=\"width:7px;height:7px;border-radius:50%;background:#7CC48A;display:inline-block\"><\u002Fspan>Online now<\u002Fdiv>\n      <\u002Fdiv>\n      <button onclick=\"{{ closeChat }}\" style=\"background:rgba(255,255,255,.12);border:none;cursor:pointer;color:#FAF6F1;width:30px;height:30px;border-radius:8px;font-size:15px;line-height:1\" style-hover=\"background:rgba(255,255,255,.28)\">✕<\u002Fbutton>\n    <\u002Fdiv>\n    <div style=\"flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:11px;background:#FAF6F1\" data-chat-scroll=\"\">\n      <sc-for list=\"{{ chatLog }}\" as=\"m\">\n        <sc-if value=\"{{ m.bot }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"align-self:flex-start;max-width:86%;background:#fff;border:1px solid #E8DED2;border-radius:4px 16px 16px 16px;padding:12px 15px;font-size:14.5px;line-height:1.55;animation:slideIn .3s ease;white-space:pre-line\">{{ m.text }}<\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ m.user }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"align-self:flex-end;max-width:86%;background:#2B2118;color:#FAF6F1;border-radius:16px 4px 16px 16px;padding:12px 15px;font-size:14.5px;line-height:1.55;animation:slideIn .3s ease\">{{ m.text }}<\u002Fdiv>\n        <\u002Fsc-if>\n      <\u002Fsc-for>\n      <sc-if value=\"{{ typing }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"align-self:flex-start;background:#fff;border:1px solid #E8DED2;border-radius:4px 16px 16px 16px;padding:12px 16px;color:#8A755E;font-size:14px\">Goldie is typing…<\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n    <div style=\"padding:12px 14px;background:#fff;border-top:1px solid #E8DED2;display:flex;flex-wrap:wrap;gap:8px\">\n      <sc-for list=\"{{ chips }}\" as=\"c\">\n        <button onclick=\"{{ c.go }}\" style=\"background:#F3EBE0;color:#6B4A2E;border:1px solid #E0D2BF;cursor:pointer;font:inherit;font-weight:500;font-size:13.5px;padding:9px 15px;border-radius:999px\" style-hover=\"background:#2B2118;color:#FAF6F1\">{{ c.label }}<\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { open: false, node: 'start', log: [], typing: false, reviewIdx: 0 };\n\n  componentDidMount() {\n    const io = new IntersectionObserver((es) => {\n      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });\n    }, { threshold: 0.12 });\n    document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));\n    this._io = io;\n    this._rot = setInterval(() => this.setState(s => ({ reviewIdx: (s.reviewIdx + 1) % 3 })), 6000);\n  }\n  componentWillUnmount() { if (this._io) this._io.disconnect(); clearTimeout(this._t); clearInterval(this._rot); }\n\n  script() {\n    return {\n      start: { bot: \"Hi love! I'm Goldie, the Gilded Root assistant. ✨ I can check prices, availability, or get you booked with the right stylist. What can I do for you?\", chips: [\n        ['Book a color appointment', 'color'], ['How much is a cut?', 'price'], ['Do you take walk-ins?', 'walkins']] },\n      color: { bot: \"Fun! Our color services start at $140 for balayage and $95 for single-process. First visit? I'd suggest booking a free 15-min consult with the color service so your stylist can plan your formula.\\n\\nWho would you like?\", chips: [\n        ['Mara — color specialist', 'stylist'], ['First available', 'stylist'], ['Tell me about balayage', 'balayage']] },\n      balayage: { bot: \"Balayage is hand-painted highlighting — soft, sun-kissed dimension that grows out beautifully (no harsh lines, fewer touch-ups). Sessions run 2.5–3 hours and start at $140 including a gloss and blowout.\", chips: [['Book it with Mara', 'stylist'], ['Back to services', 'start']] },\n      price: { bot: \"Here's the quick version:\\n\\nWomen's cut & style — from $65\\nMen's cut — from $38\\nBlowout — from $45\\n\\nEvery cut includes a consultation, wash and style. Want me to find you a time?\", chips: [['Yes, book a cut', 'stylist'], ['What about color?', 'color']] },\n      walkins: { bot: \"We do — whenever a chair is free! But Saturdays fill fast, so booking ahead is safest. I can check right now if you like. 😊\", chips: [['Check this Saturday', 'stylist'], ['Book a weekday instead', 'stylist']] },\n      stylist: { bot: \"Let me peek at the book… ✨ Here's what I've got open:\\n\\nThu 2:00pm — Mara\\nFri 10:30am — Dani\\nSat 9:00am — Mara\\n\\nWhich one should I hold?\", chips: [['Thu 2:00pm', 'confirm'], ['Fri 10:30am', 'confirm'], ['Sat 9:00am', 'confirm']] },\n      confirm: { bot: \"Held! Just need a name and number to lock it in.\", chips: [['Jordan Ellis · (912) 555-0117', 'done']] },\n      done: { bot: \"You're booked, Jordan! 💛\\n\\nYou'll get a text confirmation now and a reminder the day before. If anything changes, just reply to the text.\\n\\nSee you at 1206 Bull Street!\", chips: [['Book something else', 'start'], ['That\\u2019s all — thank you!', 'bye']] },\n      bye: { bot: \"Anytime! Can't wait to see you. ✨\", chips: [['Start over', 'start']] },\n    };\n  }\n\n  go(nodeKey, userText) {\n    const node = this.script()[nodeKey];\n    this.setState(s => ({\n      log: userText ? [...s.log, { user: true, bot: false, text: userText }] : s.log,\n      typing: true, node: nodeKey,\n    }));\n    clearTimeout(this._t);\n    this._t = setTimeout(() => {\n      this.setState(s => ({ typing: false, log: [...s.log, { bot: true, user: false, text: node.bot }] }));\n      this.scrollChat();\n    }, 750);\n    this.scrollChat();\n  }\n  scrollChat() {\n    setTimeout(() => {\n      const el = document.querySelector('[data-chat-scroll]');\n      if (el) el.scrollTop = el.scrollHeight;\n    }, 60);\n  }\n\n  renderVals() {\n    const ic = n => `https://unpkg.com/lucide-static@0.462.0/icons/${n}.svg`;\n    const node = this.script()[this.state.node];\n    const reviews = [\n      { name: 'Amelia H.', detail: 'Balayage guest since 2019', text: 'Mara spent twenty minutes just talking through what I wanted before touching a single strand. Five years of bad salon luck, over.' },\n      { name: 'Renee C.', detail: 'Bridal party of six', text: 'They handled my entire bridal party without a hitch — mimosas, music, and every single one of us cried at the mirror. Perfection.' },\n      { name: 'Jasmine P.', detail: 'Color correction', text: 'I came in with a box-dye disaster and left looking like I stepped out of a magazine. Worth every penny and then some.' },\n    ];\n    return {\n      chatOpen: this.state.open,\n      chatClosed: !this.state.open,\n      chatLog: this.state.log,\n      typing: this.state.typing,\n      chips: this.state.typing ? [] : this.script()[this.state.node].chips.map(([label, key]) => ({ label, go: () => this.go(key, label) })),\n      openChat: () => {\n        const fresh = this.state.log.length === 0;\n        this.setState({ open: true });\n        if (fresh) this.go('start', null);\n      },\n      closeChat: () => this.setState({ open: false }),\n      services: [\n        { name: \"Women's Cut & Style\", desc: 'Consultation, wash, precision cut, style', price: 'from $65' },\n        { name: \"Men's Cut\", desc: 'Clipper or shear work, hot towel finish', price: 'from $38' },\n        { name: 'Balayage', desc: 'Hand-painted dimension, gloss + blowout', price: 'from $140' },\n        { name: 'Single-Process Color', desc: 'Root touch-up or all-over color', price: 'from $95' },\n        { name: 'Color Correction', desc: 'By consultation — priced per session', price: 'from $200' },\n        { name: 'Blowout', desc: 'Wash, blow-dry and finish', price: 'from $45' },\n        { name: 'Deep Treatment', desc: 'K18 or Olaplex restorative ritual', price: 'from $55' },\n        { name: 'Bridal & Events', desc: 'In-salon or on-location styling', price: 'from $120' },\n      ],\n      experience: [\n        { icon: ic('messages-square'), title: 'Consultation first, always', desc: 'Fifteen unhurried minutes to talk texture, lifestyle and inspiration photos before we begin.' },\n        { icon: ic('coffee'), title: 'Settle in properly', desc: 'Cortado, sweet tea or prosecco — plus a scalp massage at the wash basin, every visit.' },\n        { icon: ic('heart-handshake'), title: 'Love it, or we fix it free', desc: 'Any adjustment within two weeks is on the house. No awkwardness, we promise.' },\n      ],\n      gallery: [\n        'https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?auto=format&fit=crop&w=600&q=70',\n        'https://images.unsplash.com/photo-1492106087820-71f1a00d2b11?auto=format&fit=crop&w=600&q=70',\n        'https://images.unsplash.com/photo-1519699047748-de8e457a634e?auto=format&fit=crop&w=600&q=70',\n        'https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?auto=format&fit=crop&w=600&q=70',\n      ],\n      activeReview: reviews[this.state.reviewIdx],\n      reviewDots: reviews.map((_, i) => ({\n        bg: i === this.state.reviewIdx ? '#C99A3F' : 'rgba(239,229,216,.3)',\n        go: () => this.setState({ reviewIdx: i }),\n      })),\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
